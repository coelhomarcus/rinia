{
  "name": "rinia",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "bun run --cwd apps/api dev",
    "dev:web": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build && bun run --cwd apps/api build",
    "typecheck": "bun run --filter '*' typecheck",
    "check:bundle-size": "bun run --cwd apps/web check:bundle-size",
    "lint": "bun run --cwd packages/shared lint && bun run --cwd apps/api lint && bun run --cwd apps/web lint",
    "test": "bun run --cwd apps/api test:unit && bun run --cwd apps/web test:unit",
    "test:db": "bun run --cwd apps/api test:db",
    "db:generate": "bun run --cwd apps/api db:generate",
    "db:migrate": "bun run --cwd apps/api db:migrate",
    "db:check": "bun run --cwd apps/api db:check",
    "db:seed": "bun run --cwd apps/api db:seed",
    "db:reset": "bun run --cwd apps/api db:reset",
    "knip": "knip --include files,dependencies"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "eslint": "^10.14.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "knip": "^6.44.2",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript-eslint": "^8.72.2"
  }
}
