# Postgres externo (fornecido por voce)
DATABASE_URL=postgres://user:pass@host:5432/rinia

# Auth
JWT_SECRET=troque-por-um-valor-gerado-com-openssl-rand--hex-32
JWT_EXPIRES_IN=7d

# Registro
SPECIAL_REGISTRATION_CODE=troque-por-um-codigo-secreto
ADMIN_USERNAMES=coelhomarcus

# Servidor
PORT=3000
NODE_ENV=development

# Endereco publico do Rinia, usado nos links dos e-mails, nos resultados do MCP e como issuer OAuth.
# Obrigatorio em production. Em development, sem ele, usa o endereco de cada requisicao.
# APP_URL=https://rinia.example.com

# E-mail (Resend): recuperacao de senha e troca de e-mail.
# Sem os dois, esses recursos ficam desligados; em development o e-mail vai para o log.
# O remetente precisa ser de um dominio verificado no Resend.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# RESEND_FROM_EMAIL=Rinia <noreply@example.com>
