{
  "name": "@rinia/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "build": "bun scripts/build.ts",
    "start": "bun dist/server.js",
    "typecheck": "tsc --noEmit",
    "test:unit": "bun test tests/",
    "test:db": "bun test tests-db/",
    "db:generate": "bun --bun drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts",
    "db:check": "bun scripts/check-schema-drift.ts",
    "db:seed": "bun src/db/seed.ts",
    "db:reset": "bun src/db/reset.ts && bun run db:migrate && bun run db:seed",
    "db:migrate:prod": "bun dist/migrate.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@rinia/shared": "workspace:*",
    "@tiptap/core": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/y-tiptap": "3.0.12",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.36.4",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jpeg-js": "^0.4.4",
    "jsonwebtoken": "^9.0.2",
    "lib0": "^0.2.119",
    "ms": "^2.1.3",
    "pg": "^8.13.1",
    "pngjs": "^7.0.0",
    "pino": "^10.4.0",
    "ws": "^8.18.0",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/bun": "^1.3.14",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.25",
    "@types/express-serve-static-core": "^4.19.9",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/ms": "^2.1.0",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/pngjs": "^6.0.5",
    "@types/ws": "^8.5.13",
    "drizzle-kit": "^0.30.1",
    "pino-pretty": "^13.2.0",
    "typescript": "^5.7.3"
  }
}
